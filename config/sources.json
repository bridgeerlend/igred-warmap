{
  "$comment": "Source registry. Adding a source is a config change, not a code change. ACLED is permanently excluded: its licence forbids third-party dashboard display and LLM processing.",
  "schemaVersion": 1,
  "forbidden": {
    "acled": "ACLED licence forbids display on third-party dashboards and use in AI/LLM systems. Never fetch, display or process ACLED data."
  },
  "sources": [
    {
      "id": "gdelt",
      "name": "GDELT 2.0 Event Database",
      "tier": 1,
      "role": "pulse",
      "enabled": true,
      "requiresCredential": false,
      "homepage": "https://www.gdeltproject.org/",
      "staleAfterHours": 6,
      "options": {
        "filesPerRun": 8,
        "maxEventAgeDays": 3,
        "minNumSources": 1
      }
    },
    {
      "id": "ucdp",
      "name": "UCDP \u2014 Uppsala Conflict Data Program",
      "tier": 3,
      "role": "verified-backbone",
      "enabled": true,
      "requiresCredential": true,
      "credentialEnvVar": "UCDP_ACCESS_TOKEN",
      "homepage": "https://ucdp.uu.se/",
      "staleAfterHours": 720,
      "options": {
        "apiVersion": "24.1",
        "pageSize": 1000,
        "maxPages": 40,
        "activeSinceYear": 2020,
        "datasets": [
          "ucdpprioconflict",
          "nonstate",
          "onesided"
        ]
      }
    },
    {
      "id": "newsfeeds",
      "name": "Curated news feeds (RSS)",
      "tier": 2,
      "role": "corroboration",
      "enabled": true,
      "requiresCredential": false,
      "homepage": "https://map.igred.org",
      "staleAfterHours": 12,
      "options": {
        "$note": "Feed list lives in config/feeds.json; behaviour in config/stories.json."
      }
    },
    {
      "id": "firms",
      "name": "NASA FIRMS active fire detections",
      "tier": 1,
      "role": "activity",
      "enabled": true,
      "requiresCredential": false,
      "homepage": "https://firms.modaps.eosdis.nasa.gov/",
      "staleAfterHours": 48,
      "options": {
        "product": "modis",
        "gridDegrees": 0.25,
        "minConfidence": 50,
        "minDetectionsPerCell": 2,
        "maxCells": 4000,
        "$keyNote": "The documented API needs a free MAP_KEY, but FIRMS publishes the same global 24h products as keyless CSV. No setup required."
      }
    },
    {
      "id": "media",
      "name": "Curated social and video channels",
      "tier": 2,
      "role": "context",
      "enabled": true,
      "requiresCredential": false,
      "homepage": "https://map.igred.org",
      "staleAfterHours": 24,
      "options": {
        "postsPerAccount": 15,
        "videosPerChannel": 10,
        "maxAgeDays": 7,
        "$note": "Account lists live in config/channels.json."
      }
    }
  ]
}
