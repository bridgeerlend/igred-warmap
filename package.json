{
  "name": "igred-warmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IGRED Global Conflict Monitor \u2014 automated, fully sourced global conflict map",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx src/core/cli/ingest.ts",
    "backfill": "tsx src/core/cli/backfill.ts",
    "health-check": "tsx src/core/cli/health-check.ts",
    "detect-report": "tsx scripts/detect-report.ts",
    "design": "tsx scripts/build-map-geometry.ts && tsx scripts/build-design.ts",
    "design:fixture": "tsx scripts/build-design-fixture.ts",
    "verify": "npm run typecheck && npm run test",
    "preview:data": "tsx scripts/build-preview-data.ts",
    "site:snapshot": "tsx scripts/build-preview-data.ts && tsx scripts/build-site-snapshot.ts",
    "serve": "tsx scripts/serve-design.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "edition": "tsx src/core/cli/edition.ts",
    "draft": "tsx src/core/cli/draft-summaries.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
